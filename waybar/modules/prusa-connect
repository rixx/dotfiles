#!/usr/bin/env python3
"""Waybar module: remaining time of running Prusa Connect jobs, plus a
desktop notification when a job finishes.

Uses OAuth with account.prusa3d.com; run `prusa-connect login`.
"""
import base64
import hashlib
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ACCOUNT = "https://account.prusa3d.com"
CONNECT = "https://connect.prusa3d.com"
CLIENT_ID = "oamhmhZez7opFosnwzElIgE2oGgI2iJORSkw587O"  # PrusaSlicer's
REDIRECT = "prusaslicer://login"
STATE_DIR = os.path.expanduser("~/.local/state/prusa-connect")
TOKENS = os.path.join(STATE_DIR, "tokens.json")
PENDING = os.path.join(STATE_DIR, "pending-login")
CALLBACK = os.path.join(STATE_DIR, "callback-url")
SEEN = os.path.expanduser("~/.cache/waybar-prusa-connect.json")
HANDLER = "prusa-connect-login.desktop"
REFRESH_LEAD = 300
LOGIN_TIMEOUT = 300
HOME_SSIDS = {"hobbingen", "hopsingen"}

ICON = "\U000f042b"  # nf-md-printer_3d
ICON_FONT = "NotoSansM Nerd Font Mono"
SEP = "·"
ACTIVE = {"PRINTING", "PAUSED", "ATTENTION"}
FONT = "Iosevka"
SIZE = "13pt"
ACCENT = "#D84315"
BRIGHT = "#ffffff"
MUTED = "#cccccc"
TEAL = "#99ffdd"
EMPTY = "#5a5a5a"
BAR_WIDTH = 24
WARN_AT = 600      # seconds left; bar text turns orange
CRITICAL_AT = 300  # and red
RANK = ("idle", "printing", "paused", "attention", "warning", "critical")


def ensure_dir():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)


def write_private(path, data):
    ensure_dir()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)


def post_form(url, fields):
    body = urllib.parse.urlencode(fields).encode()
    request = urllib.request.Request(url, data=body, headers={
        "Content-Type": "application/x-www-form-urlencoded",
        "User-Agent": "waybar-prusa-connect",
    })
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.load(response)


def jwt_exp(token):
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return json.loads(base64.urlsafe_b64decode(payload)).get("exp", 0)


def store_tokens(data):
    if not data.get("access_token") or not data.get("refresh_token"):
        raise RuntimeError(f"token response incomplete: {list(data)}")
    write_private(TOKENS, json.dumps({
        "access_token": data["access_token"],
        "refresh_token": data["refresh_token"],
        "exp": jwt_exp(data["access_token"]),
    }))


def access_token():
    with open(TOKENS) as f:
        tokens = json.load(f)
    if tokens["exp"] - time.time() > REFRESH_LEAD:
        return tokens["access_token"]
    data = post_form(f"{ACCOUNT}/o/token/", {
        "grant_type": "refresh_token",
        "client_id": CLIENT_ID,
        "refresh_token": tokens["refresh_token"],
    })
    store_tokens(data)
    return data["access_token"]


def install_handler():
    current = subprocess.run(
        ["xdg-mime", "query", "default", "x-scheme-handler/prusaslicer"],
        capture_output=True, text=True).stdout.strip()
    if current and current != HANDLER:
        return
    apps = os.path.expanduser("~/.local/share/applications")
    os.makedirs(apps, exist_ok=True)
    with open(os.path.join(apps, HANDLER), "w") as f:
        f.write(
            "[Desktop Entry]\nType=Application\nName=Prusa Connect login\n"
            f"Exec={os.path.abspath(__file__)} callback %u\n"
            "NoDisplay=true\nMimeType=x-scheme-handler/prusaslicer;\n")
    subprocess.run(["xdg-mime", "default", HANDLER, "x-scheme-handler/prusaslicer"],
                   check=True)


def login():
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    write_private(PENDING, verifier)
    if os.path.exists(CALLBACK):
        os.remove(CALLBACK)
    install_handler()
    url = f"{ACCOUNT}/o/authorize/?" + urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "response_type": "code",
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        "scope": "basic_info",
        "redirect_uri": REDIRECT,
    })
    print("Log in in the browser, then let it open the prusaslicer:// link.")
    print(f"Handler not fired? Run: {sys.argv[0]} callback '<redirect url>'")
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    deadline = time.time() + LOGIN_TIMEOUT
    while not os.path.exists(CALLBACK):
        if time.time() > deadline:
            sys.exit("timed out waiting for the login redirect")
        time.sleep(1)
    with open(CALLBACK) as f:
        redirect = f.read().strip()
    os.remove(CALLBACK)
    exchange(redirect, verifier)


def exchange(redirect, verifier):
    code = urllib.parse.parse_qs(urllib.parse.urlsplit(redirect).query).get("code")
    if not code:
        sys.exit(f"no code in {redirect}")
    store_tokens(post_form(f"{ACCOUNT}/o/token/", {
        "code": code[0],
        "client_id": CLIENT_ID,
        "grant_type": "authorization_code",
        "redirect_uri": REDIRECT,
        "code_verifier": verifier,
    }))
    os.remove(PENDING)
    printers = fetch()["printers"]
    print("logged in; printers: " + ", ".join(p.get("name", "?") for p in printers))


def callback(url):
    if os.path.exists(PENDING):
        write_private(CALLBACK, url)
        return
    os.execvp("prusa-slicer", ["prusa-slicer", url])


def at_home():
    try:
        status = subprocess.run(["wpa_cli", "status"], capture_output=True,
                                text=True, timeout=5).stdout
    except Exception:
        return False
    return any(line == f"ssid={ssid}" for line in status.split("\n")
               for ssid in HOME_SSIDS)


def fetch():
    request = urllib.request.Request(f"{CONNECT}/app/printers", headers={
        "Authorization": f"Bearer {access_token()}",
        "User-Agent": "waybar-prusa-connect",
    })
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.load(response)


def until_text(seconds):
    seconds = int(seconds)
    hours, minutes = divmod(seconds // 60, 60)
    if hours >= 24:
        return f"{hours // 24}d {hours % 24}h"
    if hours:
        return f"{hours}h {minutes:02d}m"
    return f"{minutes}m"


def colour(text, value, weight=None):
    attrs = f"color='{value}'" + (f" weight='{weight}'" if weight else "")
    return f"<span {attrs}>{text}</span>"


def escape(text):
    return str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def job_of(printer):
    return printer.get("job_info") or {}


def notify_finished(printers):
    try:
        with open(SEEN) as f:
            seen = json.load(f)
    except Exception:
        seen = {}
    current = {}
    for printer in printers:
        job = job_of(printer)
        state = printer.get("printer_state")
        current[printer["uuid"]] = {
            "job": job.get("id"), "state": state,
            "name": job.get("display_name") or job.get("path") or "",
        }
        before = seen.get(printer["uuid"])
        if not before or before["state"] not in ACTIVE or not before["job"]:
            continue
        same_job = job.get("id") == before["job"]
        if (same_job and state == "FINISHED") or (not same_job and state not in ACTIVE):
            subprocess.run([
                "notify-send", "-a", "Prusa Connect", "-i", "printer",
                "Print finished",
                f"{printer.get('name', '?')}: {before['name']}",
            ])
    with open(SEEN, "w") as f:
        json.dump(current, f)


def icon():
    return f"<span font_family='{ICON_FONT}'>{ICON}</span>"


def meter(percent):
    filled = max(0, min(BAR_WIDTH, round(percent / 100 * BAR_WIDTH)))
    return colour("█" * filled, TEAL) + colour("─" * (BAR_WIDTH - filled), EMPTY)


def render(printers):
    parts, blocks, worst = [], [], "idle"
    for printer in printers:
        state = printer.get("printer_state") or "UNKNOWN"
        if state not in ACTIVE:
            continue
        job = job_of(printer)
        remaining = job.get("time_remaining")
        if remaining is None:
            done, left = "?", "?"
        else:
            done = time.strftime("%H:%M", time.localtime(time.time() + remaining))
            left = until_text(remaining)
        parts.append(done if state == "PRINTING" else f"{done} ({state.lower()})")
        level = state.lower()
        if remaining is not None and remaining <= CRITICAL_AT:
            level = "critical"
        elif remaining is not None and remaining <= WARN_AT:
            level = "warning"
        worst = max(worst, level, key=RANK.index)
        progress = float(job.get("progress") or 0)
        blocks.append(
            colour(f"{progress:.0f}%", BRIGHT, "bold") + "  " + meter(progress)
            + "\n" + colour(f"{left} left {SEP} done {done}", MUTED))
    return {
        "text": f"{icon()} " + f" {SEP} ".join(parts) if parts else "",
        "tooltip": f"<span font='{FONT}' size='{SIZE}'>" + "\n\n".join(blocks) + "</span>",
        "class": worst,
    }


def main():
    args = sys.argv[1:]
    if args[:1] == ["login"]:
        return login()
    if args[:1] == ["callback"]:
        return callback(args[1])
    if args[:1] == ["--raw"]:
        return print(json.dumps(fetch(), indent=2))
    if not at_home():
        return print(json.dumps({"text": "", "class": "away"}))
    try:
        printers = fetch().get("printers") or []
    except FileNotFoundError:
        return print(json.dumps({"text": f"{icon()} login", "class": "error",
                                 "tooltip": "prusa-connect login"}))
    except Exception as error:
        return print(json.dumps({"text": f"{icon()} ?", "class": "error",
                                 "tooltip": escape(f"Prusa Connect: {error}")}))
    notify_finished(printers)
    print(json.dumps(render(printers)))


if __name__ == "__main__":
    main()
