#!/usr/bin/env fish

argparse -n ',pxtx' h/help 'p/prompt=' 'm/model=' -- $argv
or exit 1

if set -q _flag_help; or test (count $argv) -lt 1; or test (count $argv) -gt 2
    echo "usage: ,pxtx [--prompt <extra>] [--model <model>] <number> [topic]"
    if set -q _flag_help
        exit 0
    end
    exit 1
end

if not git rev-parse --is-inside-work-tree >/dev/null 2>&1
    cd ~/src/pretalx/main
    or exit 1
end

set -l model opus
if set -q _flag_model
    set model $_flag_model
end

set -l number (string replace -ri '^px-' '' -- $argv[1])
set -l topic $argv[2]
set -l branchname

if test -z "$topic"
    set branchname (git for-each-ref --format='%(refname:lstrip=2)' refs/heads | string match -r "^px-$number(?:-.*)?\$")[1]
end

if test -z "$branchname"; and test -z "$topic"
    set -l title (pxtx --json show $number | jq -r '.issue.title // empty')
    if test -z "$title"
        echo "Could not fetch the title of PX-$number" >&2
        exit 1
    end
    set topic (echo $title | claude -p --model fable --tools "" --setting-sources "" --no-session-persistence \
        "Name a git branch topic for the issue title on stdin. Shorter is better: one or two words where they suffice, three at most. Lower-case, hyphen-separated, keep the most specific terms. Examples: 'Allow organisers to export speaker emails as CSV' -> speaker-email-export; 'Crash when submission has no track' -> track-crash; 'Favicon setting' -> favicon. Reply with the topic only.")
end

if test -z "$branchname"
    set topic (string match -rv '^\s*$' -- $topic)[-1]
    set topic (string join ' ' -- $topic | string lower | string replace -ra '[^a-z0-9]+' - | string trim -c -)
    set topic (string join - -- (string split - -- $topic)[1..3])
    set branchname px-$number
    if test -n "$topic"
        set branchname $branchname-$topic
    end
end

worktree $branchname
or exit 1

set -l prompt "Use the pxtx-dev skill to work on PX-$number end to end, from implementation through review."

if pxtx spec pull $number
    set prompt "$prompt A spec for this issue exists in openspec/changes/pxtx-$number/. Instruct the implementation agent to apply it with the opsx:apply skill."
end

if set -q _flag_prompt
    set prompt "$prompt Additional context: $_flag_prompt"
end

just install-all
and just run compilemessages
and claude --chrome --model $model $prompt
