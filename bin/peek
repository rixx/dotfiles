#!/usr/bin/env bash
# peek: run a command (or read stdin, or read files), save the full output
# to a scratch file, and print a bounded excerpt. One step instead of the
# usual `cmd | tee /tmp/out.log | tail` two-step, so the full output always
# lands on disk even if you only meant to glance at it.
#
# Usage:
#   peek [-n LINES] [--head|--tail|--both] [--] COMMAND [ARGS...]
#   peek [-n LINES] [--head|--tail|--both] [--] FILE [FILE...]
#   COMMAND | peek [-n LINES] [--head|--tail|--both]
#
# Defaults to the last 50 lines (--tail), since build/test output usually
# puts its summary at the end. Always prints the exit status, line count,
# and the log file path so you can Read/Grep the rest afterwards.
#
# In `peek -- COMMAND` form, peek runs the command itself and exits with
# the command's status, so `$?`/`$status` after peek is the real one. In
# pipe form (`COMMAND | peek`) the upstream status is not visible to peek
# at all, so it reports `exit ?` rather than claiming success; use
# `peek -- COMMAND` (or fish's `$pipestatus[1]`) when you need the status.
set -uo pipefail

lines=50
mode=tail

while (( $# )); do
  case "$1" in
    -n) lines=$2; shift 2 ;;
    --head) mode=head; shift ;;
    --tail) mode=tail; shift ;;
    --both) mode=both; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

logdir="${TMPDIR:-/tmp}"
logfile=$(mktemp "$logdir/peek.XXXXXX.log")

if (( $# == 0 )); then
  if [[ -t 0 ]]; then
    echo "usage: peek [-n LINES] [--head|--tail|--both] [--] COMMAND [ARGS...]" >&2
    echo "       peek [-n LINES] [--head|--tail|--both] [--] FILE [FILE...]" >&2
    echo "       COMMAND | peek [-n LINES] [--head|--tail|--both]" >&2
    rm -f "$logfile"
    exit 64
  fi
  cat > "$logfile"
  # Reading stdin: the producer's exit status never reaches us. Say so
  # instead of printing a fake 0 that reads like the command succeeded.
  status=unknown
elif command -v "$1" >/dev/null 2>&1; then
  "$@" > "$logfile" 2>&1
  status=$?
else
  # Not a command. If every argument is a readable file, peek at the files
  # themselves: `peek -n 60 --head /tmp/x.log` is the obvious thing to type,
  # and refusing it just costs a round-trip.
  all_files=1
  for arg in "$@"; do
    [[ -f $arg && -r $arg ]] || { all_files=0; break; }
  done

  if (( ! all_files )); then
    printf 'peek: %s\n' "$1: not a command, and not a readable file." >&2
    printf '      %s\n' "Usage: peek [-n LINES] [--head|--tail|--both] [--] COMMAND [ARGS...]" >&2
    printf '      %s\n' "       peek [-n LINES] [--head|--tail|--both] [--] FILE [FILE...]" >&2
    rm -f "$logfile"
    exit 127
  fi

  if (( $# == 1 )); then
    # Single file is already its own log; don't copy it.
    rm -f "$logfile"
    logfile=$1
    status=0
  else
    cat -- "$@" > "$logfile"
    status=$?
  fi
fi

total=$(wc -l < "$logfile")

case "$mode" in
  head)
    head -n "$lines" "$logfile"
    ;;
  tail)
    tail -n "$lines" "$logfile"
    ;;
  both)
    if (( total <= lines * 2 )); then
      cat "$logfile"
    else
      head -n "$lines" "$logfile"
      echo "... $((total - lines * 2)) lines omitted ..."
      tail -n "$lines" "$logfile"
    fi
    ;;
esac

echo
if [[ $status == unknown ]]; then
  echo "[exit ? (piped; use 'peek -- CMD' to forward it), $total lines total, full output: $logfile]"
  exit 0
fi
echo "[exit $status, $total lines total, full output: $logfile]"
exit "$status"
